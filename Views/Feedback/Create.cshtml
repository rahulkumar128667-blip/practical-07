@model practical_07.Models.Feedback

@{
    ViewBag.Title = "Create Feedback";
}

@Html.Partial(
    "~/Views/Shared/StudentInfo.cshtml"
)

<h2>Create Feedback</h2>

@using (Html.BeginForm("Create", "Feedback", FormMethod.Post))
{
    @Html.ValidationSummary(
        true,
        "",
        new { @class = "error" }
    )

    <br />

    @Html.LabelFor(m => m.Name)

    <br />

    @Html.TextBoxFor(m => m.Name)

    <br />

    @Html.ValidationMessageFor(
        m => m.Name,
        "",
        new { @class = "error" }
    )

    <br />
    <br />


    @Html.LabelFor(m => m.EnrollmentNumber)

    <br />

    @Html.TextBoxFor(m => m.EnrollmentNumber)

    <br />

    @Html.ValidationMessageFor(
        m => m.EnrollmentNumber,
        "",
        new { @class = "error" }
    )

    <br />
    <br />


    @Html.LabelFor(m => m.Subject)

    <br />

    @Html.TextBoxFor(m => m.Subject)

    <br />

    @Html.ValidationMessageFor(
        m => m.Subject,
        "",
        new { @class = "error" }
    )

    <br />
    <br />


    @Html.LabelFor(m => m.Rating)

    <br />

    @Html.DropDownListFor(
        m => m.Rating,
        new SelectList(
            new[]
            {
                new { Value = "1", Text = "1" },
                new { Value = "2", Text = "2" },
                new { Value = "3", Text = "3" },
                new { Value = "4", Text = "4" },
                new { Value = "5", Text = "5" }
            },
            "Value",
            "Text"
        ),
        "Select Rating"
    )

    <br />

    @Html.ValidationMessageFor(
        m => m.Rating,
        "",
        new { @class = "error" }
    )

    <br />
    <br />


    @Html.LabelFor(m => m.Comment)

    <br />

    @Html.TextAreaFor(
        m => m.Comment,
        5,
        40,
        null
    )

    <br />

    @Html.ValidationMessageFor(
        m => m.Comment,
        "",
        new { @class = "error" }
    )

    <br />
    <br />

    <input type="submit"
           value="Submit Feedback"
           class="btn" />

    <br />
    <br />

    @Html.ActionLink(
        "Back to Home",
        "Index",
        "Feedback"
    )
}